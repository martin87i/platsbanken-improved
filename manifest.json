{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "sv",
  "version": "2.70.3",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage"],

  "content_scripts": [{
    "matches": ["https://arbetsformedlingen.se/*"],
    "js": ["profiles.js", "kartotek.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],

  "web_accessible_resources": [{
    "resources": ["fetched_ads/*"],
    "matches": ["https://arbetsformedlingen.se/*"]
  }],

  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  },

  "browser_specific_settings": {
    "gecko": { 
	"id": "platsbanken-improved@lowkeylokee.dev",
    "strict_min_version": "109.0",
	"data_collection_permissions": {
        "required": ["none"]
      }	
	}
  }
}
